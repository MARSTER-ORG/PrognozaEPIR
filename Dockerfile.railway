# Dedicated Python runtime for the external central-ingestor service.
# Archive manifest hashing is incremental in the event runtime; GitHub mirror
# reconciliation remains a separate consumer of the validated snapshot.
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    INGEST_INTERVAL_SECONDS=300 \
    LIGHTNING_FEATURES_ENABLED=1 \
    EUMETSAT_COLLECTION_ID=EO:EUM:DAT:0691

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir eumdac netCDF4

COPY . /app

EXPOSE 8080

CMD ["python", "scripts/railway_opera_server.py"]
